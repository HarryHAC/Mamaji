# ── Mama Ji — password-reset OTP (server-side only) ──
# These are read by the Vercel serverless function api/otp.js. They are NEVER
# exposed to the browser (no VITE_ prefix), so the secret keys stay private.
# Set them in Vercel → Project → Settings → Environment Variables (all envs),
# then redeploy. Do NOT commit real values.

# Required: a long random string used to sign OTP tokens.
# Generate one with:  openssl rand -hex 32
OTP_SECRET=

# ── Email channel (Resend) ──  https://resend.com
# Create an API key, and verify a sending domain (or use the test sender).
RESEND_API_KEY=
# Verified sender. Examples:
#   Mama Ji <noreply@yourdomain.com>     (after verifying yourdomain.com)
#   onboarding@resend.dev                (Resend's shared test sender)
RESEND_FROM=

# ── SMS channel (Twilio) ──  https://www.twilio.com
# From the Twilio Console. TWILIO_FROM must be an SMS-capable number in E.164.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
